# BloodRadar environment template — copy to .env (local) or fill in the
# Render dashboard Environment tab. NEVER commit a real .env file.
#
# Every key mirrors backend/config/config.ts. See DEPLOYMENT-RUNBOOK.md
# for what to ask the founder for and how to generate each value.

# --- Boot (required in production) ----------------------------------------
NODE_ENV=production
PORT=3000
# Generate: openssl rand -base64 48  (must be >= 32 characters)
JWT_SECRET=
# e.g. https://bloodradar.example.com — strict CORS + cookie security
FRONTEND_URL=
# Optional: public API origin when the frontend is hosted separately.
# For the single-service blueprint leave empty (same origin).
BACKEND_URL=

# --- Database ---------------------------------------------------------------
# MongoDB Atlas connection string, e.g.
# mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Absent = in-memory fallback (dev only; data lost on restart).
MONGO_URI=

# --- AI triage --------------------------------------------------------------
# Absent = chatbot degrades to honest fallback replies.
GEMINI_API_KEY=

# --- SMS outbound -------------------------------------------------------------
# One of: console (dev), twilio, custom-gateway
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# custom-gateway: HTTP endpoint that accepts POST { to, text } as JSON.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# --- SMS inbound webhook -------------------------------------------------------
# Shared secret the gateway sends as x-webhook-secret header (or Bearer).
# Production warns at boot when unset (webhook would accept unauthenticated calls).
SMS_WEBHOOK_SECRET=

# --- Web push (VAPID) ------------------------------------------------------------
# Generate: npx web-push generate-vapid-keys --json
# All three must be set for push; absent = UI honestly says "not configured".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Locale & roles ---------------------------------------------------------------
COUNTRY_CODE=92
NOTIFICATION_TZ=Asia/Karachi
# Comma-separated +CC numbers granted roles at login (OTP-verified).
ADMIN_PHONES=
STAFF_PHONES=
NGO_PHONES=

# --- Background jobs ---------------------------------------------------------------
# Set "true" only after SMS delivery is proven working end-to-end.
ENABLE_DONATION_REMINDERS=false

# --- Logging -----------------------------------------------------------------------
LOG_LEVEL=info
