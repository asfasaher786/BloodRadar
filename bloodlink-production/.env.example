# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# "production" enables the fail-fast env validation and strict cookie/CORS
# behaviour. "development" relaxes them (dev-only demo admin, console SMS).
NODE_ENV=production

# ── Database (MongoDB Atlas — leave blank to use in-memory fallback) ──────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ── AI (Google Gemini — optional; the app degrades to rule-based replies) ─────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Auth (REQUIRED in production — generate with: openssl rand -base64 48) ─────
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars

# ── Roles: OTP-verified phone lists, comma-separated (international format) ────
# ADMIN_PHONES=+923331234567,+923009998877
# STAFF_PHONES=+923001112233
# NGO_PHONES=+923004445566

# ── SMS provider: console | twilio | custom-gateway ───────────────────────────
# console = codes printed server-side (dev only — never use in production)
SMS_PROVIDER=console
# Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+14155552671
# Custom gateway (any provider with an HTTP API):
# SMS_PROVIDER=custom-gateway
# SMS_GATEWAY_URL=https://sms.your-provider.com/send
# SMS_GATEWAY_BEARER_TOKEN=optional-bearer-token

# ── Internationalisation: default country code for local-format numbers ───────
# Change to deploy in another country without touching code. Numbers typed
# with an explicit "+" are always respected as-is.
# COUNTRY_CODE=92

# ── Optional: 90-day donation reminder job ────────────────────────────────────
# ENABLE_DONATION_REMINDERS=true

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# REQUIRED in production (used for strict CORS and cookie security).
FRONTEND_URL=https://your-frontend-domain.example
BACKEND_URL=https://your-backend-domain.example

# For the frontend — set in the hosting dashboard or .env.local:
# VITE_API_URL=https://your-backend-domain.example
